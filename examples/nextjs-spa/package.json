{
  "name": "ridm-example-nextjs-spa",
  "version": "0.1.0",
  "private": true,
  "description": "Example: a Next.js single-page app signing users in with rIDM (authorization code + PKCE, no client secret)",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "npx serve@latest out -l 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
