{
  "name": "ridm-ui",
  "version": "0.4.1",
  "private": true,
  "description": "rIDM admin console, account console and end-user auth pages (static export)",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/csp.mjs out",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:api": "npx -y -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript ../api/openapi.json -o lib/api/openapi.d.ts",
    "serve": "npx serve@latest out",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
