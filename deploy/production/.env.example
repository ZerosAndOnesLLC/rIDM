# Copy to .env next to compose.yml and edit. Secrets do not go here: they are
# files under ./secrets, written by ./init.sh.

# The proxy: caddy, nginx or traefik.
COMPOSE_PROFILES=caddy

# The public host. PUBLIC_URL is https://$RIDM_DOMAIN, and every tenant's
# issuer is https://$RIDM_DOMAIN/t/{slug}: choose it before registering any
# client, since changing it later changes every issuer.
RIDM_DOMAIN=id.example.com

# Tenants' custom domains, space-separated. Each needs a DNS record pointing
# here, and (with RIDM_TLS_MODE=files) a place in the certificate.
RIDM_CUSTOM_DOMAINS=

# acme: Caddy or Traefik obtains and renews certificates from Let's Encrypt
#       (ports 80 and 443 must be reachable from the internet).
# files: ./certs/fullchain.pem and ./certs/privkey.pem, which you keep
#       renewed. nginx always uses files.
RIDM_TLS_MODE=acme

# The first global administrator, created in `master` on first start with the
# password ./init.sh wrote to secrets/bootstrap_admin_password, to be changed
# at first sign-in. Leave empty to create one with `ridm-api bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=

# Where researchers report vulnerabilities in this deployment, served at
# /.well-known/security.txt (404 while empty): mailto:, tel: or https: URIs,
# comma-separated, and optionally a page describing your disclosure policy.
SECURITY_CONTACT=
SECURITY_POLICY_URL=

# Outgoing mail for tenants that have no SMTP settings of their own. The
# password goes in secrets/smtp_password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_SECURITY=starttls

# The image. Pin a release tag in production.
RIDM_IMAGE=ghcr.io/zerosandonesllc/ridm:latest

# Sizing.
RIDM_MEMORY_LIMIT=1g
RIDM_PG_SHARED_BUFFERS=512MB
RIDM_VALKEY_MAXMEMORY=512mb

# Host ports and the proxy network; change only on a clash.
RIDM_HTTP_PORT=80
RIDM_HTTPS_PORT=443
RIDM_EDGE_SUBNET=172.30.53.0/24
RIDM_PROXY_ADDRESS=172.30.53.10
