# ---------------------------------------------------------------------------
# rIDM configuration. Copy to `.env` for local development; in production set
# these as real environment variables (task definition, Helm values, systemd).
# ---------------------------------------------------------------------------

# Required -----------------------------------------------------------------

# Postgres 16+ connection string for the API. Use a NON-superuser role with
# DML privileges only: superusers bypass row level security (which backs tenant
# isolation) and table owners can disable it. Run migrations separately as the
# role that owns the schema (`ridm-api migrate`, or `sqlx migrate run`), or set
# MIGRATE_ON_START=true to let this role own the schema (simpler, less strict).
DATABASE_URL=postgres://ridm_app:ridm_app@localhost:5432/ridm

# Redis 8+ / Valkey connection string (rediss:// for TLS, redis+sentinel:// later).
REDIS_URL=redis://localhost:6379

# Externally visible base URL. Tenant issuers are derived from it:
#   {PUBLIC_URL}/t/{tenant_slug}
PUBLIC_URL=http://localhost:8080

# Where the static UI is served. Defaults to PUBLIC_URL (embedded mode).
# UI_URL=https://id.example.com

# 32-byte master key encrypting secrets at rest (signing keys, IdP secrets,
# SMTP passwords). Hex or base64. Generate with:  openssl rand -hex 32
# Alternatively mount it as a file and set MASTER_KEY_FILE=/run/secrets/master_key
MASTER_KEY=
# MASTER_KEY_FILE=/run/secrets/ridm_master_key
# Key generation stored with each ciphertext; bump when rotating the master key
# and list the previous generations until every row has been re-encrypted.
# MASTER_KEY_VERSION=1
# MASTER_KEY_PREVIOUS=1=<old hex key>

# Optional -----------------------------------------------------------------

# Listen address (default 0.0.0.0:8080).
BIND_ADDR=127.0.0.1:8080

# json (production) | pretty (development).
LOG_FORMAT=pretty

# tracing filter, e.g. info,ridm_api=debug,sqlx=warn
RUST_LOG=info,ridm_api=debug

# Serve Swagger UI at /docs. Keep off in production.
DOCS_ENABLED=true

# Set the Secure attribute on cookies. Only disable for plain-http local dev.
COOKIE_SECURE=false

# Comma-separated CIDRs/IPs whose X-Forwarded-For / Forwarded headers are
# trusted (your reverse proxy or load balancer). Empty = never trust headers.
TRUSTED_PROXIES=

# Native TLS termination (both required together). Leave unset when a reverse
# proxy terminates TLS.
# TLS_CERT=/etc/ridm/tls/fullchain.pem
# TLS_KEY=/etc/ridm/tls/privkey.pem

# Connection pool sizing.
DB_POOL_MIN=2
DB_POOL_MAX=20

# Apply pending migrations on startup as DATABASE_URL's role. Prefer running
# `ridm-api migrate` as a dedicated migrator role (see above).
MIGRATE_ON_START=false

# argon2id cost parameters for password hashing. Defaults: 19 MiB, 2 iterations,
# 1 lane (OWASP minimum). Existing hashes with weaker parameters are upgraded
# transparently on the user's next successful login.
# ARGON2_M_COST_KIB=19456
# ARGON2_T_COST=2
# ARGON2_P_COST=1

# First-run bootstrap (dev convenience; Phase 1.6). Ignored once the master
# tenant exists.
# BOOTSTRAP_ADMIN_EMAIL=admin@ridm.local
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Now-1234
# BOOTSTRAP_SAMPLE_CLIENT=true

# Outbound email defaults; tenants can override them with their own SMTP or
# HTTP settings in the admin console. SMTP_SECURITY: starttls | tls | none.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="rIDM <no-reply@example.com>"
# SMTP_SECURITY=none
